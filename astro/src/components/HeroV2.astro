---
/**
 * HeroV2 - 01 ヒーロー
 * 設計書準拠: 呼吸する体験のヒーローセクション
 */
interface Props {
  imageSrc: string;
  imageAlt: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}
const { imageSrc, imageAlt, primaryCta, secondaryCta } = Astro.props;
---
<section class="hero" aria-label="ヒーロー">
  <!-- Background image with blur → sharp reveal -->
  <div class="hero-bg" role="img" aria-label={imageAlt}>
    <img src={imageSrc} alt="" width="2400" height="1400" loading="eager" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>

  <!-- Grain texture overlay -->
  <svg class="grain" aria-hidden="true">
    <filter id="grain-filter">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-filter)" />
  </svg>

  <!-- Content -->
  <div class="hero-content">
    <!-- Eyebrow -->
    <div class="eyebrow reveal-item" data-delay="0">
      <span class="eyebrow-bar" aria-hidden="true"></span>
      <span class="eyebrow-text">Expressway Deck Renewal</span>
    </div>

    <!-- Giant typography with overflow reveal -->
    <h1 class="hero-title">
      <span class="line-wrap">
        <span class="line reveal-item" data-delay="1">RENEW,</span>
      </span>
      <span class="line-wrap">
        <span class="line reveal-item" data-delay="2">NOT <span class="accent">REBUILD.</span></span>
      </span>
    </h1>

    <!-- Main copy (Gothic) -->
    <p class="hero-main-copy reveal-item" data-delay="3">
      削る、直す、復旧する。
    </p>

    <!-- Description -->
    <p class="hero-desc reveal-item" data-delay="4">
      高速道路の床版リニューアルを、はつり・断面修復・防水・舗装復旧まで一社で完結。福岡・大野城を拠点に、全国の高速道路リニューアルに対応します。
    </p>

    <!-- CTA buttons -->
    <div class="hero-ctas reveal-item" data-delay="5">
      <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
      {secondaryCta && <a href={secondaryCta.href} class="btn-ghost">{secondaryCta.label}</a>}
    </div>
  </div>

  <!-- Scroll indicator (center bottom) -->
  <div class="scroll-indicator reveal-item" data-delay="6" aria-hidden="true">
    <span class="scroll-text">SCROLL</span>
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  /* === Design System Variables === */
  :root {
    --ease-out-expo: cubic-bezier(.22, 1, .36, 1);
    --ink: #0c0f13;
    --ink2: #11151b;
    --orange: #e8741e;
    --steel: #22456e;
  }

  /* === Base === */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 680px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    isolation: isolate;
  }

  /* === Background with blur → sharp === */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: blur(8px);
    transform: scale(1.06);
    animation: hero-reveal 2.2s var(--ease-out-expo) forwards;
    will-change: filter, transform;
  }
  @keyframes hero-reveal {
    to {
      filter: blur(0);
      transform: scale(1);
    }
  }

  /* === Gradient overlay === */
  .hero-overlay {
    position: absolute;
    inset: 0;
    /* transform持ちのimgより上に出す（hero-bg自体がz:-3なので本文より下のまま） */
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(12, 15, 19, 0.5) 0%,
      rgba(12, 15, 19, 0.1) 40%,
      rgba(12, 15, 19, 0.75) 100%
    );
  }

  /* === Grain texture === */
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.05;
    pointer-events: none;
  }

  /* === Content === */
  .hero-content {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px 80px;
    color: #fff;
  }

  /* === Eyebrow === */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }
  .eyebrow-bar {
    width: 36px;
    height: 3px;
    background: var(--orange);
    border-radius: 2px;
  }
  .eyebrow-text {
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  /* === Giant typography === */
  .hero-title {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(44px, 12vw, 180px);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 28px;
  }
  .line-wrap {
    display: block;
    overflow: hidden;
  }
  .line {
    display: block;
  }
  .hero-title .accent {
    color: var(--orange);
  }

  /* === Main copy (Gothic) === */
  .hero-main-copy {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: clamp(20px, 3.2vw, 40px);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0 0 24px;
  }

  /* === Description === */
  .hero-desc {
    max-width: 34em;
    font-size: 14.5px;
    line-height: 2;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 36px;
  }

  /* === CTA buttons === */
  .hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--orange);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.3s var(--ease-out-expo), transform 0.3s var(--ease-out-expo);
  }
  .btn-primary:hover {
    background: #d16518;
    transform: translateY(-2px);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: transparent;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: 6px;
    transition: background 0.3s var(--ease-out-expo), border-color 0.3s var(--ease-out-expo), transform 0.3s var(--ease-out-expo);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #fff;
    transform: translateY(-2px);
  }

  /* === Scroll indicator (center bottom) === */
  .scroll-indicator {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.5);
  }
  .scroll-text {
    font-family: 'Archivo', sans-serif;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
  }
  .scroll-line::before {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 50%;
    background: var(--orange);
    animation: scroll-drop 2s var(--ease-out-expo) infinite;
  }
  @keyframes scroll-drop {
    0% { top: -50%; opacity: 0; }
    30% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* === Reveal animation (once only) === */
  .reveal-item {
    opacity: 0;
    transform: translateY(28px);
  }
  .reveal-item.in {
    animation: reveal-up 0.9s var(--ease-out-expo) forwards;
  }
  .line {
    transform: translateY(110%);
  }
  .line.in {
    animation: line-up 1.1s var(--ease-out-expo) forwards;
  }
  @keyframes reveal-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes line-up {
    to {
      transform: translateY(0);
    }
  }

  /* === Reduced motion === */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg img { animation: none; filter: none; transform: none; }
    .scroll-line::before { animation: none; opacity: 1; top: 25%; }
    .reveal-item { opacity: 1; transform: none; }
    .reveal-item.in { animation: none; }
    .line { transform: none; }
    .line.in { animation: none; }
  }

  /* === Responsive === */
  @media (max-width: 1023px) {
    .hero-content {
      padding: 0 32px 64px;
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 600px;
    }
    /* モバイルは文字が写真の明部と重なるため下部の暗幕を強める */
    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(12, 15, 19, 0.5) 0%,
        rgba(12, 15, 19, 0.2) 35%,
        rgba(12, 15, 19, 0.82) 72%,
        rgba(12, 15, 19, 0.9) 100%
      );
    }
    .hero-content {
      padding: 0 20px 56px;
    }
    .hero-title {
      margin-bottom: 20px;
    }
    .hero-main-copy {
      margin-bottom: 18px;
    }
    .hero-desc {
      font-size: 14px;
      line-height: 1.9;
      margin-bottom: 28px;
    }
    .hero-ctas {
      flex-direction: column;
      gap: 12px;
    }
    .btn-primary,
    .btn-ghost {
      width: 100%;
      padding: 14px 24px;
    }
    .eyebrow {
      margin-bottom: 20px;
    }
    .eyebrow-bar {
      width: 28px;
    }
    .eyebrow-text {
      font-size: 10px;
      letter-spacing: 0.28em;
    }
    .scroll-indicator {
      bottom: 24px;
    }
  }
</style>

<script>
  // Reveal animation on load with stagger (runs once)
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.hero .reveal-item, .hero .line');

    items.forEach((item) => {
      const delay = parseInt(item.getAttribute('data-delay') || '0', 10);
      // Stagger: 150ms base + delay index * 150ms
      const staggerDelay = 300 + delay * 150;

      setTimeout(() => {
        item.classList.add('in');
      }, staggerDelay);
    });
  });
</script>
