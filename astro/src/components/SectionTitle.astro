---
interface Props {
  text: string;
  eyebrow?: string;
  level?: 2 | 3;
  align?: 'left' | 'center';
  invert?: boolean;
}
const { text, eyebrow, level = 2, align = 'left', invert = false } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---
<header class:list={['section-title', `align-${align}`, invert && 'invert']}>
  {eyebrow && (
    <p class="eyebrow">
      <span class="eyebrow-num">{eyebrow.split(' / ')[0]}</span>
      {eyebrow.includes(' / ') && (
        <>
          <span class="eyebrow-divider" aria-hidden="true"></span>
          <span class="eyebrow-label">{eyebrow.split(' / ').slice(1).join(' / ')}</span>
        </>
      )}
    </p>
  )}
  <Tag>{text}</Tag>
  <span class="accent" aria-hidden="true"></span>
</header>
<style>
  .section-title { margin: 0 0 var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-3); }
  .section-title.align-center { align-items: center; text-align: center; }
  .eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-base);
    font-size: var(--fs-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
    color: var(--color-orange-600);
  }
  .eyebrow-num { font-feature-settings: 'tnum' 1; }
  .eyebrow-divider {
    display: inline-block;
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .eyebrow-label { color: var(--color-navy-900); letter-spacing: 0.24em; }
  .section-title.invert .eyebrow-label { color: var(--color-white); }
  .section-title h2, .section-title h3 {
    font-size: var(--fs-4xl);
    font-weight: var(--fw-extrabold);
    color: var(--color-navy-900);
    letter-spacing: -0.01em;
    line-height: var(--lh-snug);
    margin: 0;
  }
  .section-title.invert h2, .section-title.invert h3 { color: var(--color-white); }
  .accent {
    display: block;
    width: 56px;
    height: 4px;
    background: var(--color-orange-600);
    margin-top: var(--sp-2);
  }
  @media (max-width: 768px) {
    .section-title h2, .section-title h3 { font-size: var(--fs-3xl); }
  }
  @media (max-width: 480px) {
    .section-title h2, .section-title h3 { font-size: var(--fs-2xl); }
    .eyebrow { font-size: 10px; letter-spacing: 0.24em; }
  }
</style>
