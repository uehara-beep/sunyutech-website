---
/**
 * ProcessSection - 03 一社完結＝6工程
 * 設計書準拠: できることを見せるセクション
 * 明るい背景版（薄いグレー #f5f6f8、白カード、紺文字 #1f3a5f、オレンジアクセント）
 */

// 工程データ（写真パスは後から差し替え可能）
const processes = [
  {
    num: '01',
    name: '残As撤去',
    desc: '既存舗装の除去',
    note: '搭乗機式スクレーパーも対応可能',
    image: '/images/process/step1.jpg',
  },
  {
    num: '02',
    name: '床版はつり',
    desc: 'CONJETロボット',
    image: '/images/process/step2.jpg',
  },
  {
    num: '03',
    name: '断面修復',
    desc: '欠損部の再生',
    image: '/images/process/step3.jpg',
  },
  {
    num: '04',
    name: '研掃',
    desc: '表面処理',
    note: 'SB・WJによる下地処理・表面処理に対応可能',
    image: '/images/process/step4.jpg',
  },
  {
    num: '05',
    name: '床版防水',
    desc: '層の新設',
    note: '各社協業で施工実績あり',
    image: null,
  },
  {
    num: '06',
    name: '舗装復旧',
    desc: '一気に再生',
    image: '/images/process/step6.jpg',
  },
];
---
<section class="process-section" aria-label="6工程">
  <div class="process-container">
    <!-- Section Header -->
    <header class="process-header reveal-item" data-delay="0">
      <p class="process-kick">Renewal Process</p>
      <h2 class="process-title">はつりから舗装復旧まで、一社で。</h2>
    </header>

    <!-- Timeline -->
    <div class="timeline">
      <div class="timeline-line" aria-hidden="true"></div>

      {processes.map((step, index) => (
        <article class="process-step reveal-item" data-delay={index + 1}>
          <!-- Large background number -->
          <div class="step-bg-num" aria-hidden="true">{step.num}</div>

          <!-- Content -->
          <div class="step-content">
            <div class="step-meta">
              <span class="step-num">{step.num}</span>
              <div class="step-text">
                <h3 class="step-name">{step.name}</h3>
                <p class="step-desc">{step.desc}</p>
                {step.note && <p class="step-note">{step.note}</p>}
              </div>
            </div>

            {step.image && (
              <!-- Photo placeholder with parallax -->
              <div class="step-photo-wrap">
                <div class="step-photo parallax-photo" data-parallax="0.12">
                  <div class="photo-placeholder">
                    <span>{step.name}</span>
                  </div>
                  <img
                    src={step.image}
                    alt={`${step.name}の施工写真`}
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* === Design System Variables === */
  :root {
    --ease-out-expo: cubic-bezier(.22, 1, .36, 1);
    --bg-light: #f5f6f8;
    --card-white: #ffffff;
    --navy: #1f3a5f;
    --orange: #e8741e;
    --gray-light: #e8eaed;
    --gray-text: #6b7280;
  }

  /* === Section Base === */
  .process-section {
    position: relative;
    background: var(--bg-light);
    padding: 120px 0 140px;
    overflow: hidden;
  }

  .process-container {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* === Section Header === */
  .process-header {
    margin-bottom: 80px;
  }

  .process-kick {
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--orange);
    margin: 0 0 16px;
  }

  .process-title {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 900;
    line-height: 1.2;
    color: var(--navy);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* === Timeline === */
  .timeline {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    left: 60px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--gray-light) 5%,
      var(--gray-light) 95%,
      transparent 100%
    );
  }

  /* === Process Step === */
  .process-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    padding: 60px 0;
    border-bottom: 1px solid var(--gray-light);
  }

  .process-step:last-child {
    border-bottom: none;
  }

  /* Large background number */
  .step-bg-num {
    position: absolute;
    top: 40px;
    left: -20px;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(120px, 18vw, 240px);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(31, 58, 95, 0.08);
    letter-spacing: -0.03em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* Content */
  .step-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 48px;
    align-items: start;
    padding-left: 100px;
  }

  .step-meta {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .step-num {
    font-family: 'Archivo', sans-serif;
    font-size: 14px;
    font-weight: 900;
    color: var(--orange);
    letter-spacing: 0.1em;
    flex-shrink: 0;
    padding-top: 6px;
  }

  .step-text {
    flex: 1;
  }

  .step-name {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 900;
    color: var(--navy);
    margin: 0 0 8px;
    letter-spacing: 0.01em;
  }

  .step-desc {
    font-size: 14px;
    color: var(--gray-text);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .step-note {
    font-size: 12px;
    color: var(--gray-text);
    margin: 4px 0 0;
    letter-spacing: 0.02em;
  }

  /* === Photo === */
  .step-photo-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--card-white);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(31, 58, 95, 0.08);
  }

  .step-photo {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .step-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .photo-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border: 1px solid var(--gray-light);
    border-radius: 8px;
  }

  .photo-placeholder span {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 16px;
    font-weight: 900;
    color: rgba(31, 58, 95, 0.18);
    letter-spacing: 0.15em;
  }

  /* === Reveal Animation === */
  .reveal-item {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .reveal-item.in {
    opacity: 1;
    transform: translateY(0);
  }

  /* === Reduced Motion === */
  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .parallax-photo {
      transform: none !important;
    }
  }

  /* === Responsive === */
  @media (max-width: 1200px) {
    .step-content {
      grid-template-columns: 280px 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 1023px) {
    .process-container {
      padding: 0 32px;
    }
    .process-section {
      padding: 80px 0 100px;
    }
    .process-header {
      margin-bottom: 60px;
    }
    .timeline-line {
      left: 40px;
    }
    .step-content {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-left: 80px;
    }
    .step-bg-num {
      font-size: clamp(100px, 16vw, 180px);
      left: -10px;
    }
  }

  @media (max-width: 820px) {
    .process-container {
      padding: 0 20px;
    }
    .process-section {
      padding: 64px 0 80px;
    }
    .process-header {
      margin-bottom: 48px;
    }
    .timeline-line {
      display: none;
    }
    .step-content {
      padding-left: 0;
    }
    .process-step {
      padding: 40px 0;
    }
    .step-bg-num {
      position: relative;
      top: 0;
      left: 0;
      font-size: 80px;
      margin-bottom: -40px;
    }
    .step-meta {
      gap: 16px;
    }
    .step-photo-wrap {
      aspect-ratio: 16 / 9;
    }
    .process-kick {
      font-size: 10px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const easeOutExpo = 'cubic-bezier(.22, 1, .36, 1)';

    // === Reveal Animation (once only) ===
    const revealItems = document.querySelectorAll('.process-section .reveal-item');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const delay = parseInt(entry.target.getAttribute('data-delay') || '0', 10);
            setTimeout(() => {
              entry.target.classList.add('in');
            }, delay * 100);
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    revealItems.forEach((item) => {
      revealObserver.observe(item);
    });

    // === Parallax (always running) ===
    const parallaxPhotos = document.querySelectorAll('.parallax-photo');

    if (parallaxPhotos.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let ticking = false;

      const updateParallax = () => {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;

        parallaxPhotos.forEach((photo) => {
          const rect = photo.getBoundingClientRect();
          const elementCenter = rect.top + rect.height / 2;
          const viewportCenter = windowHeight / 2;
          const offset = elementCenter - viewportCenter;
          const coefficient = parseFloat(photo.getAttribute('data-parallax') || '0.12');

          // Apply parallax transform
          const translateY = offset * coefficient * -1;
          photo.style.transform = `translate3d(0, ${translateY}px, 0) scale(1.1)`;
        });

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      updateParallax(); // Initial call
    }
  });
</script>
