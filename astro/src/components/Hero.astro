---
import Button from './Button.astro';
import BrandSignature from './BrandSignature.astro';
interface Props {
  heading1: string;
  heading2: string;
  sub: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  imageSrc: string;
  imageAlt: string;
  showSignature?: boolean;
}
const { heading1, heading2, sub, primaryCta, secondaryCta, imageSrc, imageAlt, showSignature = true } = Astro.props;
const steps = [
  { num: '1', label: '床版はつり' },
  { num: '2', label: '断面修復' },
  { num: '3', label: '床版防水' },
  { num: '4', label: '舗装復旧' },
];
---
<section class="hero" aria-label="ヒーロー">
  <div class="hero-bg" role="img" aria-label={imageAlt}>
    <img src={imageSrc} alt="" width="2400" height="1400" loading="eager" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>
  <div class="hero-inner">
    <div class="hero-text">
      <ol class="hero-steps" aria-label="ワンストップ4工程へ移動">
        {steps.map(s => (
          <li>
            <a href="#process">
              <span aria-hidden="true">{s.num}</span>
              <span class="visually-hidden">{s.label}</span>
            </a>
          </li>
        ))}
      </ol>
      {showSignature && <BrandSignature variant="eyebrow" />}
      <h1>
        <span>{heading1}</span>
        <span>{heading2}</span>
      </h1>
      <p class="hero-sub">{sub}</p>
      <div class="hero-ctas">
        <Button variant="primary" href={primaryCta.href} label={primaryCta.label} />
        {secondaryCta && <Button variant="secondary" href={secondaryCta.href} label={secondaryCta.label} />}
      </div>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-label">SCROLL</span>
    <span class="scroll-line"></span>
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 86vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(115deg, rgba(6, 15, 28, 0.92) 0%, rgba(6, 15, 28, 0.78) 38%, rgba(11, 37, 69, 0.55) 70%, rgba(11, 37, 69, 0.30) 100%),
      linear-gradient(180deg, rgba(6, 15, 28, 0.55) 0%, rgba(6, 15, 28, 0.20) 50%, rgba(6, 15, 28, 0.70) 100%);
  }
  .hero-inner {
    width: 100%;
    max-width: var(--wrapper-max);
    margin: 0 auto;
    padding: 0 var(--gutter-desktop);
  }
  .hero-text {
    max-width: 760px;
    color: var(--color-white);
  }

  .hero-steps {
    display: flex;
    gap: var(--sp-4);
    margin: 0 0 var(--sp-6);
    font-family: var(--font-en);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-en-wide);
  }
  .hero-steps a {
    color: rgba(255, 255, 255, 0.7);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    padding: var(--sp-1) var(--sp-2);
  }
  .hero-steps a:hover { color: var(--color-orange-600); text-decoration: none; }
  .hero-steps a:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }

  :global(.hero) :global(.brand-sig-eyebrow) {
    color: var(--color-white);
    border-bottom-color: rgba(255, 255, 255, 0.35);
  }
  .hero h1 {
    font-size: var(--fs-7xl);
    font-weight: var(--fw-extrabold);
    color: var(--color-white);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-6);
  }
  .hero h1 span { display: block; }
  .hero-sub {
    font-size: var(--fs-xl);
    color: rgba(255, 255, 255, 0.86);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-8);
    max-width: 56ch;
  }
  .hero-ctas { display: flex; gap: var(--sp-4); flex-wrap: wrap; }

  .hero-scroll {
    position: absolute;
    bottom: var(--sp-8);
    right: var(--gutter-desktop);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-base);
    font-size: var(--fs-xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: var(--fw-semibold);
  }
  .scroll-line {
    display: inline-block;
    width: 60px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
    position: relative;
    overflow: hidden;
  }
  .scroll-line::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 30%;
    height: 100%;
    background: var(--color-orange-600);
    animation: scroll-slide 2.4s ease-in-out infinite;
  }
  @keyframes scroll-slide {
    0% { transform: translateX(-30%); }
    100% { transform: translateX(220%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-line::before { animation: none; }
  }

  @media (max-width: 1023px) {
    .hero-inner { padding: 0 var(--gutter-tablet); }
    .hero h1 { font-size: var(--fs-6xl); }
    .hero-scroll { right: var(--gutter-tablet); }
  }
  @media (max-width: 768px) {
    .hero { min-height: 78vh; }
    .hero-inner { padding: 0 var(--gutter-mobile); }
    .hero h1 { font-size: var(--fs-4xl); }
    .hero-sub { font-size: var(--fs-lg); }
    .hero-scroll { display: none; }
  }
</style>
